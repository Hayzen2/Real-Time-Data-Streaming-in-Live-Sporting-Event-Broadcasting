# Set this to a secure random string (e.g., my_super_secret_key_123)
STREAM_KEY=your_secure_stream_key_here
# Set this to a secure password for the admin panel
ADMIN_PASSWORD=your_admin_password_here
# Set this to your Playit secret key for dynamic tunnel management
PLAYIT_SECRET_KEY=your_playit_secret_key_here
# Set this to your Ngrok Authtoken for automatic web tunnels
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
